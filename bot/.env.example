# Copy to .env before deploying. Never commit real values.

# Dry run: true logs every reply instead of calling Meta. Keep true until the
# webhook, the answers, and the spend caps have all been checked.
DRY_RUN=true

PORT=8080

# From the Meta dashboard, WhatsApp > API Setup.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v21.0

# Any non-empty value you choose. Must match the token you enter in the Meta
# webhook config, or verification fails.
WEBHOOK_VERIFY_TOKEN=

# Salt for hashing phone numbers before they reach the cost log.
# Changing this breaks continuity of the monthly free-allowance accounting.
# Generate once, store in EasyPanel as a secret, never in git.
BOT_HASH_SALT=

# auto = detect hi/mr/en per message. Or pin one: en | hi | mr
START_LANG=auto
